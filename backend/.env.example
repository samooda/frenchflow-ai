OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=frenchflow
PINECONE_NAMESPACE=
FRONTEND_ORIGIN=http://localhost:5173

# Supabase is accessed directly from the frontend (auth + user data via RLS).
# The backend is RAG-only and does not use Supabase, so no Supabase keys are
# required here. If the backend ever needs service-role access, add
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY (backend-only — never expose the
# service role key to the frontend).
